# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API. Never commit .env.local or the real
# keys anywhere; .env.local is gitignored.
#
# The anon/public key is safe to expose in client-side code — access is
# still enforced by the Row Level Security policies in supabase/migrations.
# Never put the service_role key in this app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
